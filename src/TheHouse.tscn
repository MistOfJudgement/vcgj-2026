[node name="Clue1" parent="NavigationRegion2D" unique_id=407064830 node_paths=PackedStringArray("destinationArea") instance=ExtResource("4_yq4or")]
position = Vector2(2093, 1820)
text = "Oh, dearest Miriam, you would not believe the trouble I have been through in recent days! Though father promised me that he would attend the ball, he simply drove me there in his automobile at 6:00 PM and then left! Truly, in my time of torment, there is only you, for me, even though our respective status tear us apart.
Sincerely,
Bella"
destinationArea = NodePath("../../CanvasLayer/PauseButton")

[node name="Clue2" parent="NavigationRegion2D" unique_id=1920973038 node_paths=PackedStringArray("destinationArea") instance=ExtResource("4_yq4or")]
position = Vector2(-1197, 2308)
text = "Paige, my one and only beloved, every day I appreciate the skill you bring to tidying our humble mansion more. You would not believe the trouble I’ve been through finding good help to clean up our little escapade the other night! Three people can spill so much blood… but I would do it again for you my dear. I shall think of you always. You are the only one for me.
Sincerely,
Bella"
destinationArea = NodePath("../../CanvasLayer/PauseButton")

[node name="Clue3" parent="NavigationRegion2D" unique_id=87679880 node_paths=PackedStringArray("destinationArea") instance=ExtResource("4_yq4or")]
position = Vector2(82, -452)
text = "Stephanie, I am sorry I could not meet with you last night. Father and I had plans to go to a wonderful Victorian Re-enactment Ball that I had almost forgotten about! It was a wonderful time, and I stayed well into the night at 12 AM, though I missed you dearly the whole time. Shall we reschedule for another time? I would ever so hate to fall out of your favor-- despite your position in the employ of our family, I look at you as though you are the only girl in the world.
Sincerely,
Bella"
destinationArea = NodePath("../../CanvasLayer/PauseButton")

[node name="Clue4" parent="NavigationRegion2D" unique_id=857561954 node_paths=PackedStringArray("destinationArea") instance=ExtResource("4_yq4or")]
position = Vector2(1676, -1292)
text = "Mr. Chaz Carnefellow,
We, your lawyers, implore you to cease business with a certain accountant. Do not ask how we have this information-- you have more important things to worry about. Mr. Vioqualia-Fisher’s under the table accounting practices have put us and ours at a loss for years now. Should you manage to get him out of the picture, all will be forgiven. Should you fail, we will pursue you within and without the force of the law.
Sincerely,
Your Mafioso Lawyers"
destinationArea = NodePath("../../CanvasLayer/PauseButton")

[node name="Clue5" parent="NavigationRegion2D" unique_id=500844468 node_paths=PackedStringArray("destinationArea") instance=ExtResource("4_yq4or")]
position = Vector2(-402, 1123)
text = "Macintosh,
For the love of god, you have to get better passwords. Not every single thing you own can be locked behind your birthday. You are the member of an old money family, your internet safety cannot begin and end with a date that anyone can find by looking it up on Wikipedia. It’s a major holiday, too! 12/31 is like, the first thing that someone would guess, especially if Father is going to be entrusting you with a mysterious safe to keep locked up in your room.
- Reginald"
destinationArea = NodePath("../../CanvasLayer/PauseButton")

[node name="Clue6" parent="NavigationRegion2D" unique_id=1230103675 node_paths=PackedStringArray("destinationArea") instance=ExtResource("4_yq4or")]
position = Vector2(419, 1999.0001)
scale = Vector2(0.8137789, 0.8435629)
text = "Macintosh, Hey big guy! You know you’re my favorite! So I like to be informed of what’s going on in your life, ya dig? Ya feel? So if you could like, tell people when you’re going out to wander around in the woods for 6 hours at night like you did last night, so I don’t have to send Good ol’ Reggie to chase after you for hours at a time to make sure you haven’t been kidnapped by mafiosos or something, I would really appreciate it! Love ya kid.
- Chaz"
destinationArea = NodePath("../../CanvasLayer/PauseButton")

[node name="Clue7" parent="NavigationRegion2D" unique_id=1136841907 node_paths=PackedStringArray("destinationArea") instance=ExtResource("4_yq4or")]
position = Vector2(507, 2032)
scale = Vector2(0.61262107, 0.61262107)
text = "Dad,
No.
Mac"
destinationArea = NodePath("../../CanvasLayer/PauseButton")

[node name="Clue8" parent="NavigationRegion2D" unique_id=1038475898 node_paths=PackedStringArray("destinationArea") instance=ExtResource("4_yq4or")]
position = Vector2(579, -836)
text = "Reginald, for the love of god, STOP leaving your rifles around the house! Everybody knows that the M19 is for PANSIES! What will guests think if they come over??? Clean up your act and act like a real man!!
- Chaz"
