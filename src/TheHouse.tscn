[node name="Clue9" parent="NavigationRegion2D" unique_id=40423912 node_paths=PackedStringArray("destinationArea") instance=ExtResource("4_yq4or")]
position = Vector2(1889, 1238)
text = "Dear Diary,
Father is unreasonably asking me to hide this strange safe in my room again. Supposedly it contains something important in it that he needs to keep the family safe. Surely if it was so important he could have told me what was in it? I just know he approached me at 9 PM last night with the safe in hand, and told me I must not let anybody access it. I fear for what this could mean for him. But he is a man. He can fight his own battles.
- Macintosh"
destinationArea = NodePath("../../CanvasLayer/PauseButton")

[node name="Clue10" parent="NavigationRegion2D" unique_id=791022163 node_paths=PackedStringArray("destinationArea") instance=ExtResource("4_yq4or")]
position = Vector2(-710, 585)
text = "O Blackest Of Demon Swords,
I Beseach Thee With Thy Onyx Flames
Come Unto Me And Give Me Power
That I Might Destroy The Lads and Dames
Who Defy Me
And Do Nut Understant
my,
soul………
- Cursed Demon Reginald’s Unfinished Poetry Collection"
